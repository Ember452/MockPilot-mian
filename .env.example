# ============================================================
# MockPilot 全栈 Docker 部署环境变量【模板】
# 使用方法：复制本文件为 .env，并填入真实密钥
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows)
# .env 已加入 .gitignore，不会被提交到仓库
# ============================================================

# --- 前端构建上下文（可选）---
# 默认直接从 GitHub 前端仓库远程构建，无需配置；
# 本地开发前端时取消注释并指向本地前端目录，例如：
#   FRONTEND_BUILD_CONTEXT=../MockPilot-Frontend-main/AI-Meeting-Frontend-main
#FRONTEND_BUILD_CONTEXT=

# --- Docker 镜像版本 ---
MYSQL_IMAGE=mysql:8.0
MONGO_IMAGE=mongo:7.0
REDIS_IMAGE=redis:7.2-alpine
ES_IMAGE=elasticsearch:9.2.1
MILVUS_IMAGE=milvusdb/milvus:v2.5.11
BUILDER_IMAGE=maven:3.9-eclipse-temurin-17
RUNTIME_IMAGE=eclipse-temurin:17-jre-jammy

# --- 对外端口（宿主机） ---
FRONTEND_PORT=80
BACKEND_PORT=8002
MYSQL_PORT_EXPOSE=3306
MONGO_PORT_EXPOSE=27017
REDIS_PORT_EXPOSE=6379
ES_PORT_EXPOSE=9200
MILVUS_PORT_EXPOSE=19530
MILVUS_METRICS_PORT_EXPOSE=9091

# --- 时区 ---
APP_TIMEZONE=Asia/Shanghai

# --- MySQL 配置（生产环境请修改密码） ---
MYSQL_DATABASE=mainshi_agent
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# --- MongoDB 配置 ---
MONGODB_DATABASE=xunzhi_agent

# --- Redis 配置 ---
REDIS_PASSWORD=

# --- RAG 向量引擎（elasticsearch | milvus）---
# 切换 milvus：1) RAG_VECTOR_STORE=milvus  2) docker compose --profile milvus up -d
# 注意：双引擎为部署期静态切换（重启生效），存量 ES 索引不会迁移，
# Milvus 模式下旧知识库需重新上传文档
RAG_VECTOR_STORE=elasticsearch

# --- AI 大模型配置（百炼 / DashScope，填入你自己的 API Key）---
SPRING_AI_OPENAI_API_KEY=sk-your-dashscope-api-key
SPRING_AI_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SPRING_AI_OPENAI_MODEL=qwen3.6-plus
SPRING_AI_OPENAI_EMBEDDING_MODEL=text-embedding-v4

# --- AI 聊天默认模型密钥（DeepSeek，https://platform.deepseek.com 获取）---
# 启动时自动注入数据库 ai_properties 中仍为占位符的行；
# 不配则 AI 聊天不可用，也可登录后通过 BYOK 界面配置自己的 Key
DEEPSEEK_API_KEY=

# --- 讯飞配置（https://console.xfyun.cn 获取）---
XUNFEI_APP_ID=your-xunfei-app-id
XUNFEI_API_KEY=your-xunfei-api-key
XUNFEI_API_SECRET=your-xunfei-api-secret
XUNFEI_RTA_API_KEY=your-xunfei-rta-api-key

# --- JWT 密钥（生产环境请换成随机长字符串）---
SA_TOKEN_JWT_SECRET=change-me-to-a-long-random-secret

# --- BYOK：用户自带 API Key 的 AES 加密密钥（Base64，16/24/32 字节）---
# 生成方式：openssl rand -base64 32；不配置则用户无法保存自己的 API Key
BYOK_ENCRYPT_KEY=
